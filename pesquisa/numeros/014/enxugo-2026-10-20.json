 "excluidos": [
  {
   "id": "crisostomo-hebr-6-1",
   "motivo": "diz o mesmo que cirilo-glaph-num-14-1: esquecem os sinais do Egito, se apavoram e querem voltar (o juramento e a morte no deserto vêm depois)."
  },
  {
   "id": "agostinho-cfaust-12-30",
   "motivo": "diz o mesmo que agostinho-inepio-7-1 (o deserto é esta vida dos fiéis, e Deus não os abandona) e bernardo-qhab-3-5 (voltar de coração ao Egito)."
  },
  {
   "id": "teodoreto-in-ps-105-24",
   "motivo": "diz o mesmo que cirilo-glaph-num-14-1: tinham visto tantos milagres e se deixaram tomar pelo medo; não fala de Josué e Caleb."
  },
  {
   "id": "cirilo-glaph-num-14-3",
   "motivo": "só narra o que origenes-hnum-8-1a e ruperto-incant-6 já dizem: Moisés suplica e Deus cede."
  },
  {
   "id": "efrem-num-14-13-16",
   "motivo": "diz o mesmo que crisostomo-jo-13-1: Moisés intercede por amor ao povo, não pela própria dignidade nem pela nação maior."
  },
  {
   "id": "bruno-innum-14-paciente-e-misericordioso",
   "motivo": "diz o mesmo que procopio-num-14-17-19 (paciência e misericórdia) e tomas-sth-1-2-87-8 (castiga só os filhos que imitam os pais)."
  },
  {
   "id": "teodoreto-in-ps-105-26",
   "motivo": "diz o mesmo que belarmino-ps77-38: por misericórdia, Deus não os castigou tanto quanto mereciam."
  },
  {
   "id": "belarmino-de-poenitentia-4-2",
   "motivo": "diz o mesmo que bruno-innum-14-perdoou-a-culpa: Deus perdoou o pecado, mas a pena ficou e todos morreram no deserto."
  },
  {
   "id": "teodoreto-q-num-27-a",
   "motivo": "diz o mesmo que cassiodoro-inps56-gloria-igreja e jeronimo-inis-3: a glória que enche a terra é a salvação levada a todas as nações."
  },
  {
   "id": "crisostomo-hebr-6-3-b",
   "motivo": "diz o mesmo que agostinho-enps-77-3 e crisostomo-1cor-23-3: o castigo do deserto é figura da perda do Reino e da pena eterna."
  },
  {
   "id": "belarmino-ps105-24-27",
   "motivo": "diz o mesmo que agostinho-enps-77-3: se Deus castigou tanto quem desprezou a terra, figura do Reino, quanto mais quem despreza o Reino."
  },
  {
   "id": "teodoreto-q-num-27-b",
   "motivo": "diz o mesmo que cirilo-glaph-num-14-4 e origenes-hnum-8-1c: as crianças que entram são figura do povo novo, os gentios que creem."
  },
  {
   "id": "lapide-num14-40-estultos",
   "motivo": "diz o mesmo que procopio-num-14-39-42: da covardia passam ao atrevimento, desobedientes nas duas vezes."
  },
  {
   "id": "ruperto-innum-1-40-horma",
   "motivo": "diz o mesmo que rabano-ennum-2-11-protervia: amalecitas, cananeus e Horma como os espíritos maus que perseguem até o anátema eterno."
  }
 ]
