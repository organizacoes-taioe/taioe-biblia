 "excluidos": [
  {
   "id": "eusebio-de-4-17",
   "motivo": "diz o mesmo que eusebio-he-1-3-4 (mesmo autor: Moisés dá ao sucessor o nome de Jesus, figura do Salvador que sucede à Lei) e que origenes-hjos-1-1 (ninguém antes teve o nome); o texto ainda tem lacuna"
  },
  {
   "id": "eusebio-ecl-1-11",
   "motivo": "diz o mesmo que agostinho-cfaust-16-19: o nome é dado quando Oseias é enviado à frente, cumprindo «o meu nome está nele» (Ex 23,21)"
  },
  {
   "id": "tertuliano-adviud-9-auses-jesus",
   "motivo": "diz o mesmo que agostinho-sermo-352-4, mais claro: o povo entra na terra não por Moisés (a Lei), mas por Jesus (a graça)"
  },
  {
   "id": "agostinho-cfaust-12-42",
   "motivo": "diz o mesmo que nissa-vm-2-267-268: o cacho pendurado no madeiro é Cristo, e o seu vinho («sangue da uva») é o sangue que salva; o resto comenta Gn 49,11"
  },
  {
   "id": "isidoro-quaestnum-15-duo-bajuli",
   "motivo": "diz o mesmo que agostinho-atrib-mai-sermo-3: o da frente é o judeu, de costas para o cacho, o de trás é o gentio, que o vê; com a mesma citação do salmo («curva sempre as suas costas»)"
  },
  {
   "id": "maximo-hom79-josue-caleb-phalanga",
   "motivo": "diz o mesmo que agostinho-atrib-mai-sermo-3: judeu à frente, de costas para o cacho, cristão atrás, que o vê sempre"
  },
  {
   "id": "ricardo-allegvt-3-2-botrus",
   "motivo": "diz o mesmo que ruperto-innum-1-37-o-da-frente-nao-ve (e beda-hom2-9-ascensao-botrus): os da frente (profetas) não viram o cacho, os de trás (apóstolos) o viram"
  },
  {
   "id": "newman-pps4-18-mau-relato",
   "motivo": "diz o mesmo que francisco-santa-marta-2018-03-20: crer no mau relato foi esquecer a força de Deus que os tinha libertado; o resto do trecho é sobre Coré (Nm 16)"
  },
  {
   "id": "cirilo-glaph-num-13-2b",
   "motivo": "diz o mesmo que origenes-hjos-18-2, mais claro: Caleb = «coração», Jefoné = «conversão», filho da conversão; os apóstolos como testemunhas já estão em ruperto-innum-1-38-caleb"
  },
  {
   "id": "origenes-hnum-7-6b",
   "motivo": "diz o mesmo que origenes-hnum-7-5c (mesma homilia): os demônios ficam gigantes ou pequenos conforme a nossa fé e a nossa vida"
