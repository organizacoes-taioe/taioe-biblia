// Worker só com arquivos estáticos. Publica só /biblia (contrato da origem, no README do
// taioe-hub). Os arquivos ficam em public/biblia/, porque o caminho completo chega ao Worker.
{
  "name": "taioe-biblia",
  "compatibility_date": "2026-09-25",
  "workers_dev": false,
  "preview_urls": true,
  "previews": {},                 // exigido pelo "npx wrangler preview" das branches
  "routes": [ { "pattern": "taioe.com.br/biblia*", "zone_name": "taioe.com.br" } ],
  "assets": { "directory": "./public", "not_found_handling": "404-page", "html_handling": "auto-trailing-slash" }
}
